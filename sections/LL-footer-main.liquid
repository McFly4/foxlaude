<style>
  .ll-footer {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 60px 40px 0;
  }

  .ll-footer__main {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    max-width: 1400px;
    margin: 0 auto;
    padding-bottom: 60px;
  }

  .ll-footer__left {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ll-footer__logo img {
    height: 90px;
    width: 200px;
    object-fit: contain;
  }

  .ll-footer__nav {
    display: flex;
    flex-direction: row;
    gap: 24px;
    flex-wrap: wrap;
    align-items: flex-start;
  }

  .ll-footer__nav-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ll-footer__nav > .ll-footer__nav-item > a {
    color: {{ section.settings.text_color }};
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    transition: opacity 0.2s;
  }

  .ll-footer__nav > .ll-footer__nav-item > a:hover {
    opacity: 0.75;
  }

  .ll-footer__nav-sub {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ll-footer__nav-sub a {
    color: {{ section.settings.text_color }};
    text-decoration: none;
    font-size: 14px;
    opacity: 0.75;
    transition: opacity 0.2s;
  }

  .ll-footer__nav-sub a:hover {
    opacity: 1;
  }

  .ll-footer__right {
    max-width: 480px;
    width: 100%;
  }

  .ll-footer__newsletter-title {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 12px 0;
    color: {{ section.settings.text_color }};
  }

  .ll-footer__newsletter-desc {
    font-size: 15px;
    opacity: 0.8;
    margin: 0 0 24px 0;
    line-height: 1.5;
  }

  .ll-footer__newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ll-footer__newsletter-input {
    width: 100%;
    padding: 14px 20px;
    border-radius: 50px;
    border: none;
    font-size: 15px;
    background: #fff;
    color: #000;
    box-sizing: border-box;
  }

  .ll-footer__newsletter-input::placeholder {
    color: #aaa;
  }

  .ll-footer__newsletter-btn {
    width: 100%;
    padding: 14px 20px;
    border-radius: 50px;
    border: none;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    background-color: {{ section.settings.btn_color }};
    color: {{ section.settings.btn_text_color }};
    transition: filter 0.2s;
  }

  .ll-footer__newsletter-btn:hover {
    filter: brightness(0.9);
  }

  .ll-footer__bottom {
    border-top: 1px solid rgba(255,255,255,0.15);
    max-width: 1400px;
    margin: 0 auto;
    padding: 20px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 13px;
    opacity: 0.75;
  }

  .ll-footer__bottom-links {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }

  .ll-footer__bottom-links a {
    color: {{ section.settings.text_color }};
    text-decoration: none;
  }

  .ll-footer__bottom-links a:hover {
    text-decoration: underline;
  }

  @media screen and (max-width: 749px) {
    .ll-footer {
      padding: 40px 20px 0;
    }

    .ll-footer__main {
      flex-direction: column;
    }

    .ll-footer__right {
      max-width: 100%;
    }

    .ll-footer__newsletter-title {
      font-size: 20px;
    }

    .ll-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<div class="ll-footer">
  <div class="ll-footer__main">
    <div class="ll-footer__left">
      {% if section.settings.logo != blank %}
        <div class="ll-footer__logo">
          {{
            section.settings.logo
            | image_url: width: 300
            | image_tag: loading: 'lazy', widths: '150, 300', alt: shop.name
          }}
        </div>
      {% endif %}

      <nav class="ll-footer__nav">
        {% assign menu = linklists[section.settings.nav_menu] %}
        {% for link in menu.links %}
          <div class="ll-footer__nav-item">
            <a href="{{ link.url }}">{{ link.title }}</a>
            {% if link.links.size > 0 %}
              <div class="ll-footer__nav-sub">
                {% for child in link.links %}
                  <a href="{{ child.url }}">{{ child.title }}</a>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </nav>
    </div>

    <div class="ll-footer__right">
      {% if section.settings.newsletter_title != blank %}
        <h2 class="ll-footer__newsletter-title">{{ section.settings.newsletter_title }}</h2>
      {% endif %}
      {% if section.settings.newsletter_desc != blank %}
        <p class="ll-footer__newsletter-desc">{{ section.settings.newsletter_desc }}</p>
      {% endif %}

      {% form 'customer', id: 'll-footer-newsletter' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="ll-footer__newsletter-form">
          <input
            class="ll-footer__newsletter-input"
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.input_placeholder | default: 'Ton e-mail' }}"
            required
          >
          <button type="submit" class="ll-footer__newsletter-btn">
            {{ section.settings.btn_label | default: "Je m'inscris" }}
          </button>
        </div>
      {% endform %}
    </div>
  </div>

  <div class="ll-footer__bottom">
    <div class="ll-footer__bottom-links">
      {% for i in (1..4) %}
        {% assign label_key = 'legal_label_' | append: i %}
        {% assign url_key = 'legal_url_' | append: i %}
        {% if section.settings[label_key] != blank %}
          <a href="{{ section.settings[url_key] }}">{{ section.settings[label_key] }}</a>
        {% endif %}
      {% endfor %}
    </div>
    <div>{{ section.settings.copyright_text }}</div>
  </div>
</div>

{% schema %}
{
  "name": "LL - Footer principal",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fond",
      "default": "#18466d"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texte",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Couleur bouton",
      "default": "#7fafc8"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Texte bouton",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "nav_menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Titre",
      "default": "Recevez 10\u20ac offerts sur votre première commande"
    },
    {
      "type": "textarea",
      "id": "newsletter_desc",
      "label": "Description",
      "default": "Inscrivez-vous à la newsletter et recevez immédiatement 10€ offerts sur votre première commande"
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Placeholder email",
      "default": "Ton e-mail"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Texte du bouton",
      "default": "Je m'inscris"
    },
    {
      "type": "header",
      "content": "Barre légale"
    },
    {
      "type": "text",
      "id": "legal_label_1",
      "label": "Lien légal 1 - Texte",
      "default": "Mentions Légales"
    },
    {
      "type": "url",
      "id": "legal_url_1",
      "label": "Lien légal 1 - URL"
    },
    {
      "type": "text",
      "id": "legal_label_2",
      "label": "Lien légal 2 - Texte",
      "default": "Politiques de confidentialité"
    },
    {
      "type": "url",
      "id": "legal_url_2",
      "label": "Lien légal 2 - URL"
    },
    {
      "type": "text",
      "id": "legal_label_3",
      "label": "Lien légal 3 - Texte",
      "default": "Conditions générales de ventes"
    },
    {
      "type": "url",
      "id": "legal_url_3",
      "label": "Lien légal 3 - URL"
    },
    {
      "type": "text",
      "id": "legal_label_4",
      "label": "Lien légal 4 - Texte"
    },
    {
      "type": "url",
      "id": "legal_url_4",
      "label": "Lien légal 4 - URL"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Texte copyright",
      "default": "© 2025, FoxLaude — Réalisé par La-Landing"
    }
  ],
  "presets": [
    {
      "name": "LL - Footer principal",
      "category": "Custom"
    }
  ]
}
{% endschema %}
