{% liquid
  assign product = closest.product
  assign linked_products = product.metafields.custom.complete_purschase.value
%}
{% if linked_products != blank %}
  <div class="ll-complete-purchase" data-ll-complete-purchase {{ block.shopify_attributes }}>
    {% if block.settings.heading != blank %}
      <p class="ll-complete-purchase__heading">{{ block.settings.heading }}</p>
    {% endif %}
    <div class="ll-complete-purchase__list">
      {% for linked_product in linked_products %}
        {% liquid
          assign variant = linked_product.selected_or_first_available_variant
          assign has_discount = false
          if variant.compare_at_price > variant.price
            assign has_discount = true
            assign discount_percent = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
          endif
        %}
        <label class="ll-complete-purchase__item">
          <input
            type="checkbox"
            class="ll-complete-purchase__checkbox"
            name="complete-purchase"
            value="{{ variant.id }}"
          >
          <span class="ll-complete-purchase__radio"></span>
          <span class="ll-complete-purchase__info">
            <span class="ll-complete-purchase__name">{{ linked_product.title }}</span>
            <span class="ll-complete-purchase__price">
              {{ variant.price | money }}
              {% if has_discount %}
                <span class="ll-complete-purchase__compare">{{ variant.compare_at_price | money }}</span>
                <span class="ll-complete-purchase__badge">-{{ discount_percent }}%</span>
              {% endif %}
            </span>
          </span>
          {% if linked_product.featured_image %}
            <img
              class="ll-complete-purchase__image"
              src="{{ linked_product.featured_image | image_url: width: 160 }}"
              alt="{{ linked_product.featured_image.alt | escape }}"
              loading="lazy"
              width="80"
              height="80"
            >
          {% endif %}
        </label>
      {% endfor %}
    </div>
  </div>
{% endif %}

<style>
  .ll-complete-purchase {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm, 16px);
  }

  .ll-complete-purchase__heading {
    font-weight: var(--font-weight-semibold, 600);
    margin: 0;
  }

  .ll-complete-purchase__list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm, 12px);
  }

  .ll-complete-purchase__item {
    display: flex;
    align-items: center;
    gap: var(--gap-sm, 12px);
    padding: 8px;
    border-radius: 12px;
    background: var(--color-background-secondary, #f0ede8);
    cursor: pointer;
  }

  .ll-complete-purchase__checkbox {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .ll-complete-purchase__radio {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1.5px solid var(--color-foreground);
    opacity: 0.4;
  }

  .ll-complete-purchase__checkbox:checked + .ll-complete-purchase__radio {
    opacity: 1;
    border-color: var(--color-primary, #18466d);
    background: var(--color-primary, #18466d);
    box-shadow: inset 0 0 0 3px var(--color-background-secondary, #f0ede8);
  }

  .ll-complete-purchase__info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .ll-complete-purchase__name {
    font-weight: var(--font-weight-semibold, 600);
  }

  .ll-complete-purchase__price {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: var(--font-weight-semibold, 600);
  }

  .ll-complete-purchase__compare {
    font-weight: normal;
    text-decoration: line-through;
    opacity: 0.5;
  }

  .ll-complete-purchase__badge {
    background: rgb(var(--color-primary-rgb, 24 70 109) / 0.15);
    color: var(--color-primary, #18466d);
    font-size: 0.75rem;
    font-weight: var(--font-weight-semibold, 600);
    padding: 2px 8px;
    border-radius: 999px;
  }

  .ll-complete-purchase__image {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 8px;
    object-fit: cover;
  }
</style>

<script>
  (() => {
    if (window.__llCompletePurchaseBound) return;
    window.__llCompletePurchaseBound = true;

    document.addEventListener(
      'submit',
      (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement) || form.dataset.type !== 'add-to-cart-form') return;

        const container = form.closest('.shopify-section, dialog, main')?.querySelector('[data-ll-complete-purchase]');
        if (!container) return;

        const checked = container.querySelectorAll('.ll-complete-purchase__checkbox:checked');
        if (!checked.length) return;

        const items = Array.from(checked).map((input) => ({
          id: parseInt(input.value, 10),
          quantity: 1,
        }));

        fetch('{{ routes.cart_add_url }}.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items }),
        })
          .then((response) => response.json())
          .then(() => {
            document.dispatchEvent(
              new CustomEvent('cart:update', {
                bubbles: true,
                detail: {
                  resource: {},
                  sourceId: 'll-complete-purchase',
                  data: { itemCount: items.length, source: 'product-form-component' },
                },
              })
            );
          })
          .catch((error) => console.error('Erreur ajout produits complémentaires:', error));
      },
      { capture: true },
    );
  })();
</script>

{% schema %}
{
  "name": "LL Complétez votre achat",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Complétez votre achat avec le :"
    },
    {
      "type": "paragraph",
      "content": "Utilise le metafield produit custom.complete_purchase (liste de références produit)"
    }
  ],
  "presets": [
    {
      "name": "LL Complétez votre achat"
    }
  ]
}
{% endschema %}
