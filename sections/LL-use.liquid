{% comment %}
  Section: How To Use
  Description: 3 étapes avec vidéos, titres et descriptions + CTA - Carousel mobile
{% endcomment %}

<section class="how-to-use">
  <div class="page-width">
    {%- comment -%} Titre principal {%- endcomment -%}
    {% if section.settings.main_title != blank %}
      <h2 class="how-to-use__main-title">{{ section.settings.main_title }}</h2>
    {% endif %}

    {%- comment -%} Grid des 3 items - DESKTOP {%- endcomment -%}
    <div class="how-to-use__grid how-to-use__grid--desktop">
      {% for block in section.blocks %}
        {% if block.type == 'step' %}
          <div class="how-to-use__item" {{ block.shopify_attributes }}>
            {%- comment -%} Vidéo {%- endcomment -%}
            <div class="how-to-use__video-wrapper">
              {% if block.settings.video != blank %}
                <div class="video-container">
                  <video
                    class="how-to-use__video"
                    autoplay
                    loop
                    muted
                    playsinline
                    preload="metadata"
                  >
                    {% for source in block.settings.video.sources %}
                      <source src="{{ source.url }}" type="{{ source.mime_type }}">
                    {% endfor %}
                  </video>
                </div>
              {% else %}
                <div class="how-to-use__video-placeholder">
                  {{ 'lifestyle-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            {%- comment -%} Contenu texte avec numéro {%- endcomment -%}
            <div class="how-to-use__content">
              <div class="how-to-use__text-wrapper">
                <span class="how-to-use__number">{{ forloop.index }}</span>
                <div class="how-to-use__text">
                  {% if block.settings.title != blank %}
                    <h3 class="how-to-use__title">{{ block.settings.title }}</h3>
                  {% endif %}
                  {% if block.settings.subtitle != blank %}
                    <div class="how-to-use__subtitle">{{ block.settings.subtitle }}</div>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {%- comment -%} Carousel - MOBILE {%- endcomment -%}
    <div class="how-to-use__carousel how-to-use-mobile-carousel swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          {% if block.type == 'step' %}
            <div class="swiper-slide" {{ block.shopify_attributes }}>
              <div class="how-to-use__item">
                {%- comment -%} Vidéo {%- endcomment -%}
                <div class="how-to-use__video-wrapper">
                  {% if block.settings.video != blank %}
                    <div class="video-container">
                      <video
                        class="how-to-use__video"
                        autoplay
                        loop
                        muted
                        playsinline
                        preload="metadata"
                      >
                        {% for source in block.settings.video.sources %}
                          <source src="{{ source.url }}" type="{{ source.mime_type }}">
                        {% endfor %}
                      </video>
                    </div>
                  {% else %}
                    <div class="how-to-use__video-placeholder">
                      {{ 'lifestyle-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>

                {%- comment -%} Contenu texte avec numéro {%- endcomment -%}
                <div class="how-to-use__content">
                  <div class="how-to-use__text-wrapper">
                    <span class="how-to-use__number">{{ forloop.index }}</span>
                    <div class="how-to-use__text">
                      {% if block.settings.title != blank %}
                        <h3 class="how-to-use__title">{{ block.settings.title }}</h3>
                      {% endif %}
                      {% if block.settings.subtitle != blank %}
                        <div class="how-to-use__subtitle">{{ block.settings.subtitle }}</div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {%- comment -%} Pagination {%- endcomment -%}
      <div class="swiper-pagination"></div>
    </div>

    {%- comment -%} CTA unique en bas {%- endcomment -%}
    {% if section.settings.cta_text != blank and section.settings.cta_link != blank %}
      <div class="how-to-use__cta">
        <a href="{{ section.settings.cta_link }}" class="how-to-use__button button">
          {{ section.settings.cta_text }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .how-to-use {
    padding: 80px 0;
    background-color: #fff;
  }

  .page-width {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Titre principal */
  .how-to-use__main-title {
    text-align: center;
    margin-bottom: 34px;
    color: #000;
    font-size: 32px;
    font-style: normal;
    font-weight: 600;
    line-height: normal;
  }

  /* Mobile carousel caché par défaut */
  .how-to-use__carousel {
    display: none;
  }

  /* Grid 3 colonnes - Desktop visible par défaut */
  .how-to-use__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-bottom: 60px;
  }

  .how-to-use__item {
    text-align: center;
  }

  /* Vidéo wrapper */
  .how-to-use__video-wrapper {
    margin-bottom: 24px;
  }

  .video-container {
    position: relative;
    width: 100%;
    height: 750px;
    max-width: 420px;
    margin: 0 auto;
    border-radius: 12px;
    overflow: hidden;
    background-color: #000;
  }

  .how-to-use__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Placeholder vidéo */
  .how-to-use__video-placeholder {
    width: 100%;
    height: 750px;
    max-width: 420px;
    margin: 0 auto;
    background-color: #f5f5f5;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .how-to-use__video-placeholder svg {
    width: 100px;
    height: 100px;
    opacity: 0.3;
  }

  /* Contenu texte avec numéro */
  .how-to-use__content {
    padding: 0 20px;
  }

  .how-to-use__text-wrapper {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    text-align: left;
    max-width: 420px;
    margin: 0 auto;
  }

  .how-to-use__number {
    width: 27px;
    height: 27px;
    flex-shrink: 0;
    border-radius: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #9cb8aa;
    color: #9cb8aa;
    font-family: 'Manrope', sans-serif;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
  }

  .how-to-use__text {
    flex: 1;
  }

  .how-to-use__title {
    color: #000;
    margin-bottom: 11px;
    font-size: 20px;
    font-style: normal;
    font-weight: 600;
    line-height: normal;
  }

  .how-to-use__subtitle {
    color: #000;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
  }

  /* CTA */
  .how-to-use__cta {
    text-align: center;
    margin-top: 40px;
  }

  .how-to-use__button {
    padding: 11px 38px;
    border-radius: 28px;
    background: #f6e3f0;
    color: #1c1c1c;
    font-size: 16px;
    font-style: normal;
    font-weight: 600;
    line-height: normal;
  }

  @media screen and (max-width: 749px) {
    .how-to-use {
      padding: 40px 0;
    }

    .how-to-use__text-wrapper {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .how-to-use__main-title {
      font-size: 24px;
      margin-bottom: 32px;
    }

    /* Masquer la grid desktop, afficher le carousel mobile */
    .how-to-use__grid--desktop {
      display: none;
    }

    .how-to-use__carousel {
      display: block;
      margin-bottom: 40px;
      overflow: hidden;
      width: 100%;
    }

    .how-to-use-mobile-carousel .swiper-wrapper {
      display: flex;
    }

    .how-to-use-mobile-carousel .swiper-slide {
      flex-shrink: 0;
      width: 100%;
      height: auto;
    }

    .how-to-use-mobile-carousel .swiper-pagination {
      position: relative;
      margin-top: 40px;
      bottom: 0;
    }

    .how-to-use-mobile-carousel .swiper-pagination-bullet {
      border: 2px solid #9cb8aa;
      background: transparent !important;
      width: 11px;
      height: 11px;
    }

    .how-to-use-mobile-carousel .swiper-pagination-bullet-active {
      background: #9cb8aa !important;
    }

    .video-container,
    .how-to-use__video-placeholder {
      height: 500px;
    }

    .how-to-use__number {
      width: 20px;
      height: 20px;
      font-size: 14px;
    }

    .how-to-use__title {
      font-size: 18px;
      white-space: nowrap;
    }

    .how-to-use__subtitle {
      font-size: 14px;
    }

    .how-to-use__button {
      padding: 14px 40px;
      font-size: 14px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    let howToUseSwiper = null;

    function initHowToUseCarousel() {
      // Détruire l'instance existante
      if (howToUseSwiper) {
        howToUseSwiper.destroy(true, true);
        howToUseSwiper = null;
      }

      // Initialiser uniquement sur mobile
      if (window.innerWidth <= 749) {
        const carouselElement = document.querySelector('.how-to-use-mobile-carousel');

        if (carouselElement) {
          howToUseSwiper = new Swiper(carouselElement, {
            slidesPerView: 1,
            spaceBetween: 20,
            centeredSlides: true,
            pagination: {
              el: carouselElement.querySelector('.swiper-pagination'),
              clickable: true,
            },
          });

          console.log('How To Use carousel initialisé');
        }
      }
    }

    // Init au chargement
    setTimeout(() => {
      initHowToUseCarousel();
    }, 100);

    // Réinitialiser au resize
    let resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        initHowToUseCarousel();
      }, 250);
    });
  });
</script>

{% schema %}
{
  "name": "How To Use",
  "tag": "section",
  "class": "section-how-to-use",
  "settings": [
    {
      "type": "text",
      "id": "main_title",
      "label": "Titre principal",
      "default": "Comment l'utiliser"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Texte du bouton CTA",
      "default": "Découvrir nos produits"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien du bouton CTA"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "limit": 3,
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Vidéo"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Étape 1"
        },
        {
          "type": "richtext",
          "id": "subtitle",
          "label": "Description",
          "default": "<p>Description de l'étape</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How To Use",
      "settings": {
        "main_title": "Comment l'utiliser",
        "cta_text": "Découvrir nos produits"
      },
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Étape 1"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Étape 2"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Étape 3"
          }
        }
      ]
    }
  ]
}
{% endschema %}
