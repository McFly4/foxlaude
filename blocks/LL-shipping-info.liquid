<div class="ll-shipping-info" {{ block.shopify_attributes }}>
  <div class="ll-shipping-info__left">
    <span class="ll-shipping-info__truck">
      {{- 'truck.svg' | inline_asset_content -}}
    </span>
    <span class="ll-shipping-info__dot"></span>
    <span class="ll-shipping-info__text">{{ block.settings.text }}</span>
  </div>
  <img
    class="ll-shipping-info__cards"
    src="{{ 'cards.svg' | asset_url }}"
    alt=""
    loading="lazy"
    width="242"
    height="17"
  >
</div>

<style>
  .ll-shipping-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    width: 100%;
  }

  .ll-shipping-info__left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ll-shipping-info__truck {
    display: flex;
    width: 24px;
    height: 24px;
  }

  .ll-shipping-info__truck svg {
    width: 100%;
    height: 100%;
  }

  .ll-shipping-info__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4caf50;
    flex-shrink: 0;
  }

  .ll-shipping-info__text {
    font-size: var(--font-paragraph--size, 1rem);
  }

  .ll-shipping-info__cards {
    height: 17px;
    width: auto;
  }
</style>

{% schema %}
{
  "name": "LL Livraison",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Texte",
      "default": "Livraison en 2-3 jours"
    }
  ],
  "presets": [
    {
      "name": "LL Livraison"
    }
  ]
}
{% endschema %}
