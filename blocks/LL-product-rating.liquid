{% liquid
  assign product = closest.product
  assign rating_value = product.metafields.custom.rating_value.value
  assign rating_label = product.metafields.custom.rating_label.value
%}

{% if rating_value != blank %}
  <div class="ll-product-rating" {{ block.shopify_attributes }}>
    <div class="ll-product-rating__stars">
      {% assign full_stars = rating_value | floor %}
      {% for i in (1..5) %}
        <svg
          class="ll-product-rating__star{% if i <= full_stars %} ll-product-rating__star--filled{% endif %}"
          viewBox="0 0 32 32"
          role="presentation"
        >
          <path d="M31.547 12a.848.848 0 00-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 00-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 00-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 001.23.893l8.428-4.434 8.432 4.432a.847.847 0 001.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 00.214-.869z" />
        </svg>
      {% endfor %}
    </div>
    <span class="ll-product-rating__text">
      {{ rating_value }}/5
      {% if rating_label != blank %}
        . {{ rating_label }}
      {% endif %}
    </span>
  </div>
{% endif %}

{% stylesheet %}
  .ll-product-rating {
    display: flex;
    align-items: center;
    gap: var(--gap-xs, 8px);
    flex-wrap: wrap;
  }

  .ll-product-rating__stars {
    display: flex;
    gap: 2px;
  }

  .ll-product-rating__star {
    width: 18px;
    height: 18px;
    fill: rgb(var(--color-foreground-rgb) / 0.2);
  }

  .ll-product-rating__star--filled {
    fill: #f5b942;
  }

  .ll-product-rating__text {
    font-size: var(--font-paragraph-small--size, 0.875rem);
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LL Avis produit",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Utilise les metafields produit: custom.rating_value (decimal) et custom.rating_label (texte)"
    }
  ],
  "presets": [
    {
      "name": "LL Avis produit"
    }
  ]
}
{% endschema %}
