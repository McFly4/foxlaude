{% liquid
  assign product = closest.product
  assign benefits = product.metafields.custom.benefits.value
%}

{% if benefits != blank %}
  <ul class="ll-product-benefits" {{ block.shopify_attributes }}>
    {% for benefit in benefits %}
      <li class="ll-product-benefits__item">
        {% if benefit.icon != blank %}
          <span class="ll-product-benefits__icon">
            <img
              src="{{ benefit.icon | image_url: width: 80 }}"
              alt=""
              loading="lazy"
              width="40"
              height="40"
            >
          </span>
        {% else %}
          <span class="ll-product-benefits__icon ll-product-benefits__icon--empty"></span>
        {% endif %}
        <span class="ll-product-benefits__text">{{ benefit.text.value }}</span>
      </li>
    {% endfor %}
  </ul>
{% endif %}

<style>
  .ll-product-benefits {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md, 20px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ll-product-benefits__item {
    display: flex;
    align-items: center;
    gap: var(--gap-sm, 12px);
  }

  .ll-product-benefits__icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-background-secondary, #f0ede8);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ll-product-benefits__icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ll-product-benefits__icon--empty {
    background: var(--color-background-secondary, #f0ede8);
  }

  .ll-product-benefits__text {
    font-size: var(--font-paragraph--size, 1rem);
    color: var(--color-foreground);
  }
</style>

{% schema %}
{
  "name": "LL Bénéfices produit",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Utilise le metafield produit custom.benefits (liste de références metaobject 'benefit' avec champs icon + text)"
    }
  ],
  "presets": [
    {
      "name": "LL Bénéfices produit"
    }
  ]
}
{% endschema %}
