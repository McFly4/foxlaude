<style>
  .home-works {
    width: 100%;
    padding: 0 20px;
  }

  .home-works__container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .home-works__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .home-works__title {
    font-size: 32px;
    font-weight: 700;
    line-height: 1.2;
  }

  .home-works__subtitle {
    font-size: 20px;
    margin: 0;
    line-height: 1.6;
  }

  .home-works__blocks {
    display: flex;
    flex-direction: row;
    gap: 20px;
    justify-content: center;
  }

  .home-works__block {
    flex: 1;
    display: flex;
    flex-direction: column;
    max-width: 390px;
  }

  .home-works__block-image {
    width: 100%;
    height: 350px;
    overflow: hidden;
    border-radius: 8px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .home-works__block-image video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .home-works__block-image--placeholder {
    background-color: #f3f3f3;
  }

  .home-works__block-image--placeholder svg {
    width: 100%;
    height: 100%;
    max-width: 150px;
    opacity: 0.3;
  }

  .home-works__block-title {
    font-size: 24px;
    font-weight: 600;
    margin: 0 0 15px 0;
    line-height: 1.3;
  }

  .home-works__block-description {
    font-size: 16px;
    margin: 0;
    line-height: 1.6;
  }

  .home-works__cta {
    text-align: center;
    margin-top: 60px;
  }

  .home-works__cta-button {
    background-color: #18466d;
    color: white;
    padding: 10px 20px;
    border: none;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
    display: inline-block;
  }

  .home-works__cta-button:hover {
    background-color: #0f2d4a;
  }

  .home-works__cta-button a {
    text-decoration: none;
    color: white;
    display: block;
  }

  /* Responsive */
  @media screen and (max-width: 989px) {
    .home-works {
      padding: 60px 20px;
    }

    .home-works__title {
      font-size: 36px;
    }

    .home-works__subtitle {
      font-size: 18px;
    }

    .home-works__blocks {
      flex-direction: column;
      align-items: center;
    }

    .home-works__block {
      max-width: 500px;
      width: 100%;
    }
  }

  @media screen and (max-width: 749px) {
    .home-works {
      padding: 40px 20px;
    }

    .home-works__header {
      margin-bottom: 40px;
    }

    .home-works__title {
      font-size: 28px;
    }

    .home-works__subtitle {
      font-size: 16px;
    }

    .home-works__block-image {
      height: 250px;
    }

    .home-works__block-title {
      font-size: 20px;
    }

    .home-works__block-description {
      font-size: 15px;
    }
  }
</style>

<div class="home-works">
  <div class="home-works__container">
    <div class="home-works__header">
      {% if section.settings.title != blank %}
        <h2 class="home-works__title">{{ section.settings.title }}</h2>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p class="home-works__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="home-works__blocks">
      {% for block in section.blocks %}
        <div class="home-works__block" {{ block.shopify_attributes }}>
          {% if block.settings.video != blank %}
            <div class="home-works__block-image">
              {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
            </div>
          {% else %}
            <div class="home-works__block-image home-works__block-image--placeholder">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {% endif %}

          {% if block.settings.block_title != blank %}
            <h3 class="home-works__block-title">{{ block.settings.block_title }}</h3>
          {% endif %}

          {% if block.settings.description != blank %}
            <p class="home-works__block-description">{{ block.settings.description }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <div class="home-works__cta">
      <button class="home-works__cta-button">
        <a href="{{ section.settings.cta_link }}"> Je veux mon FoxLaude </a>
      </button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Home Works",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Comment ça marche"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Découvrez notre processus en 3 étapes simples"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien du bouton CTA"
    }
  ],
  "blocks": [
    {
      "type": "work_block",
      "name": "Bloc",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Vidéo"
        },
        {
          "type": "text",
          "id": "block_title",
          "label": "Titre du bloc",
          "default": "Étape 1"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Description de cette étape"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Works",
      "blocks": [
        {
          "type": "work_block"
        },
        {
          "type": "work_block"
        },
        {
          "type": "work_block"
        }
      ]
    }
  ]
}
{% endschema %}
