{% liquid
  assign before_lines = section.settings.before_text | newline_to_br | split: '<br />'
  assign after_lines = section.settings.after_text | newline_to_br | split: '<br />'
%}

<div
  class="ll-before-after section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {% if section.settings.title != blank %}
    <h2 class="ll-before-after__title">{{ section.settings.title }}</h2>
  {% endif %}

  <div class="ll-before-after__layout">
    {% if section.settings.before_text != blank %}
      <ul class="ll-before-after__column ll-before-after__column--before">
        {% for line in before_lines %}
          {% assign trimmed_line = line | strip %}
          {% if trimmed_line != blank %}
            <li>{{ trimmed_line }}</li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}

    <div class="ll-before-after__slider">
      {% content_for 'blocks' %}
    </div>

    {% if section.settings.after_text != blank %}
      <ul class="ll-before-after__column ll-before-after__column--after">
        {% for line in after_lines %}
          {% assign trimmed_line = line | strip %}
          {% if trimmed_line != blank %}
            <li>{{ trimmed_line }}</li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</div>

<style>
  .ll-before-after {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  .ll-before-after__title {
    margin: 0;
    text-align: center;
    font-size: 24px;
    font-weight: 500;
  }

  .ll-before-after__layout {
    display: grid;
    grid-template-columns: 1fr minmax(300px, 720px) 1fr;
    align-items: center;
    gap: 32px;
    width: 100%;
  }

  .ll-before-after__layout:has(.ll-before-after__column--before):not(:has(.ll-before-after__column--after)) {
    grid-template-columns: 1fr minmax(300px, 720px);
  }

  .ll-before-after__layout:has(.ll-before-after__column--after):not(:has(.ll-before-after__column--before)) {
    grid-template-columns: minmax(300px, 720px) 1fr;
  }

  .ll-before-after__layout:not(:has(.ll-before-after__column--before)):not(:has(.ll-before-after__column--after)) {
    grid-template-columns: 1fr;
    justify-items: center;
  }

  .ll-before-after__slider {
    width: 100%;
  }

  .ll-before-after__layout:not(:has(.ll-before-after__column--before)):not(:has(.ll-before-after__column--after))
    .ll-before-after__slider {
    max-width: 700px;
  }

  .ll-before-after__column {
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ll-before-after__column li {
    text-align: center;
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .ll-before-after__column--after li::before {
    content: '✕ ';
  }

  @media screen and (max-width: 989px) {
    .ll-before-after__layout,
    .ll-before-after__layout:has(.ll-before-after__column--before),
    .ll-before-after__layout:has(.ll-before-after__column--after) {
      grid-template-columns: 1fr;
    }

    .ll-before-after__column {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 16px 24px;
    }

    .ll-before-after__column li {
      flex: 1 1 40%;
    }
  }
</style>

{% schema %}
{
  "name": "LL Avant / Après",
  "tag": "section",
  "class": "ll-before-after-section",
  "blocks": [
    {
      "type": "comparison-slider"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Avant Foxlaude vs Après Foxlaude"
    },
    {
      "type": "header",
      "content": "Colonne de gauche (optionnel)"
    },
    {
      "type": "textarea",
      "id": "before_text",
      "label": "Points (un par ligne)",
      "info": "Laisser vide pour masquer la colonne"
    },
    {
      "type": "header",
      "content": "Colonne de droite (optionnel)"
    },
    {
      "type": "textarea",
      "id": "after_text",
      "label": "Points (un par ligne)",
      "info": "Laisser vide pour masquer la colonne"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Largeur",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Pleine largeur" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Haut",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bas",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "LL Avant / Après",
      "blocks": [
        {
          "type": "comparison-slider",
          "settings": {
            "slider_style": "horizontal",
            "image_ratio": "landscape",
            "border_radius": 12
          }
        }
      ]
    }
  ]
}
{% endschema %}
